// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PersonRole {
  IP_CS
  DESIGNER
  EDITOR
}

/// What a signed-in person is allowed to do across the app.
enum AppRole {
  ADMIN
  COHORT_LEADER
  IP_CS
  DESIGNER
  EDITOR
  FLOATER
}

enum PlanFormat {
  STORY
  REEL
  AV
  GIF
}

/// What kind of piece was logged: ordinary IP output, a festival piece, or
/// one-off non-IP work.
enum PieceKind {
  REGULAR
  FESTIVAL
  NON_IP
}

model Cohort {
  id             String   @id @default(cuid())
  code           String   @unique
  leaderName     String
  leaderPersonId String?
  createdAt      DateTime @default(now())

  leader Person? @relation("CohortLeader", fields: [leaderPersonId], references: [id], onDelete: SetNull)
  brands Brand[]
  shoots Shoot[]
  /// The IPs this cohort is fixed to — set once in Admin, not rotated weekly.
  ips    Ip[]
}

/// A brand (client). The table keeps its original "Client" name in the database.
model Brand {
  id               String  @id @default(cuid())
  name             String
  cohortId         String
  /// Month the brand was added after launch ("2026-10"); null for the launch roster.
  /// Each brand added after launch raises the monthly IP base target.
  addedMonthKey    String?
  /// Month from which the brand no longer counts (null = active).
  archivedMonthKey String?

  cohort   Cohort         @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  ipMonths BrandIpMonth[]
  pieces   Piece[]
  shoots   Shoot[]

  @@unique([cohortId, name])
  @@map("Client")
}

model Ip {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int    @default(0)

  assignments PersonAssignment[]
  brandMonths BrandIpMonth[]
  pieces      Piece[]
  shoots      Shoot[]
  /// The cohorts fixed to this IP — set once in Admin, not rotated weekly.
  cohorts     Cohort[]
}

model Person {
  id                 String   @id @default(cuid())
  name               String   @unique
  appRole            AppRole  @default(EDITOR)
  email              String?  @unique
  passwordHash       String?
  mustChangePassword Boolean  @default(true)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())

  assignments  PersonAssignment[]
  loggedPieces Piece[]
  sessions     Session[]
  leadsCohorts Cohort[]           @relation("CohortLeader")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  personId  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model PersonAssignment {
  id       String     @id @default(cuid())
  personId String
  ipId     String
  role     PersonRole

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  ip     Ip     @relation(fields: [ipId], references: [id], onDelete: Cascade)

  @@unique([personId, ipId, role])
}

/// The one number someone still sets ahead of time: how much of this IP a
/// brand needs this month. Achieved/live are no longer stored here - they're
/// counted from Piece, logged one at a time as the work actually happens.
model BrandIpMonth {
  id        String   @id @default(cuid())
  monthKey  String
  brandId   String
  ipId      String
  target    Int      @default(0)
  updatedAt DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  ip    Ip    @relation(fields: [ipId], references: [id], onDelete: Cascade)

  @@unique([monthKey, brandId, ipId])
  @@index([monthKey])
}

/// One piece of content, logged the moment it's made — the only act of
/// "input" in the whole app. REGULAR pieces count toward a brand's IP
/// matrix (ipId set); FESTIVAL/NON_IP pieces are the old Festive & Non-IP
/// log, folded in here (festivalId or workLabel set instead). Achieved =
/// count of matching rows; live = count with live=true.
model Piece {
  id         String      @id @default(cuid())
  monthKey   String
  brandId    String
  kind       PieceKind   @default(REGULAR)
  ipId       String?
  festivalId String?
  workLabel  String?
  format     PlanFormat?
  live       Boolean     @default(false)
  loggedById String?
  createdAt  DateTime    @default(now())

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  ip       Ip?       @relation(fields: [ipId], references: [id], onDelete: Cascade)
  festival Festival? @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  loggedBy Person?   @relation(fields: [loggedById], references: [id], onDelete: SetNull)

  @@index([monthKey, brandId, ipId])
  @@index([monthKey, brandId, kind, festivalId, workLabel, format])
}

/// Admin overrides for one month: a different IP base target, or the achieved
/// total for months before the matrix was in use.
model MonthSetting {
  monthKey         String @id
  baseOverride     Int?
  achievedOverride Int?
}

/// Key/value settings (IP monthly base, per-brand increment, seed marker).
model AppSetting {
  key   String @id
  value String
}

model Festival {
  id        String  @id @default(cuid())
  name      String
  month     Int
  dateLabel String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  pieces Piece[]
}

/// One planned shoot: who's going and when. Serial number is just the row's
/// position when listed, not stored.
model Shoot {
  id                String   @id @default(cuid())
  cohortId          String
  brandId           String
  ipId              String
  /// "YYYY-MM-DD".
  date              String
  dop               String
  socialMediaPerson String
  remarks           String   @default("")
  createdAt         DateTime @default(now())

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  brand  Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  ip     Ip     @relation(fields: [ipId], references: [id], onDelete: Cascade)

  @@index([date])
}
