// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PersonRole {
  IP_CS
  DESIGNER
  EDITOR
}

/// What a signed-in person is allowed to do across the app.
enum AppRole {
  ADMIN
  COHORT_LEADER
  IP_CS
  DESIGNER
  EDITOR
  FLOATER
}

enum StatusState {
  PENDING
  PARTIAL
  DONE
}

enum Week {
  W1
  W2
  W3
  W4
}

enum PlanKind {
  FESTIVAL
  NON_IP
}

enum PlanFormat {
  STORY
  REEL
  AV
  GIF
}

model Cohort {
  id             String   @id @default(cuid())
  code           String   @unique
  leaderName     String
  leaderPersonId String?
  createdAt      DateTime @default(now())

  leader               Person?              @relation("CohortLeader", fields: [leaderPersonId], references: [id], onDelete: SetNull)
  brands               Brand[]
  rotationAssignments  RotationAssignment[]
  tradesReleased       Trade[]              @relation("TradeReleased")
  tradesClaimed        Trade[]              @relation("TradeClaimed")
  cohortWeeklyStatuses CohortWeeklyStatus[]
}

/// A brand (client). The table keeps its original "Client" name in the database.
model Brand {
  id       String @id @default(cuid())
  name     String
  cohortId String
  /// Month the brand was added after launch ("2026-10"); null for the launch roster.
  /// Each brand added after launch raises the monthly IP base target.
  addedMonthKey    String?
  /// Month from which the brand no longer counts (null = active).
  archivedMonthKey String?

  cohort         Cohort         @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  ipMonths       BrandIpMonth[]
  plannedEntries PlannedEntry[]

  @@unique([cohortId, name])
  @@map("Client")
}

model Ip {
  id                  String @id @default(cuid())
  name                String @unique
  defaultWeeklyTarget Int
  sortOrder           Int    @default(0)

  assignments          PersonAssignment[]
  brandMonths          BrandIpMonth[]
  rotationEntries      RotationEntry[]
  trades               Trade[]
  cohortWeeklyStatuses CohortWeeklyStatus[]
}

model Person {
  id                 String   @id @default(cuid())
  name               String   @unique
  appRole            AppRole  @default(EDITOR)
  email              String?  @unique
  passwordHash       String?
  mustChangePassword Boolean  @default(true)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())

  assignments   PersonAssignment[]
  attendance    AttendanceDay[]
  sessions      Session[]
  leadsCohorts  Cohort[]           @relation("CohortLeader")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  personId  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model PersonAssignment {
  id       String     @id @default(cuid())
  personId String
  ipId     String
  role     PersonRole

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  ip     Ip     @relation(fields: [ipId], references: [id], onDelete: Cascade)

  @@unique([personId, ipId, role])
}

/// Brand x IP numbers for one month. Achieved here is the source of truth for IP output.
model BrandIpMonth {
  id        String   @id @default(cuid())
  monthKey  String
  brandId   String
  ipId      String
  target    Int      @default(0)
  achieved  Int      @default(0)
  live      Int      @default(0)
  updatedAt DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  ip    Ip    @relation(fields: [ipId], references: [id], onDelete: Cascade)

  @@unique([monthKey, brandId, ipId])
  @@index([monthKey])
}

/// Admin overrides for one month: a different IP base target, or the achieved
/// total for months before the matrix was in use.
model MonthSetting {
  monthKey         String @id
  baseOverride     Int?
  achievedOverride Int?
}

/// Key/value settings (IP monthly base, per-brand increment, seed marker).
model AppSetting {
  key   String @id
  value String
}

model Festival {
  id        String  @id @default(cuid())
  name      String
  month     Int
  dateLabel String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  entries PlannedEntry[]
}

/// One piece of planned work outside the IP matrix: either a brand's work for
/// a festival (festivalId set), or a one-off non-IP item (workLabel set, e.g.
/// "Teaser reel"). One row per piece of content (a Story, a Reel, an AV, a
/// GIF) — a brand can log several rows against the same festival or the same
/// non-IP work.
model PlannedEntry {
  id         String     @id @default(cuid())
  monthKey   String
  brandId    String
  kind       PlanKind
  festivalId String?
  workLabel  String?
  format     PlanFormat
  achieved   Int        @default(0)
  live       Int        @default(0)

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  festival Festival? @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  @@index([monthKey])
}

/// One monthly rotation cycle (a fresh W1-W4 schedule). Keeping cycles
/// separate (rather than overwriting a single live W1-W4 table) is what
/// makes month-over-month trend charts possible.
model RotationCycle {
  id        String   @id @default(cuid())
  monthKey  String   @unique // e.g. "2026-09"
  createdAt DateTime @default(now())

  entries              RotationEntry[]
  trades               Trade[]
  cohortWeeklyStatuses CohortWeeklyStatus[]
}

model RotationEntry {
  id       String @id @default(cuid())
  cycleId  String
  ipId     String
  week     Week
  target   Int
  achieved Int    @default(0)

  cycle       RotationCycle        @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  ip          Ip                   @relation(fields: [ipId], references: [id], onDelete: Cascade)
  assignments RotationAssignment[]

  @@unique([cycleId, ipId, week])
}

model RotationAssignment {
  id       String @id @default(cuid())
  entryId  String
  cohortId String

  entry  RotationEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  cohort Cohort        @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([entryId, cohortId])
}

model Trade {
  id                String   @id @default(cuid())
  cycleId           String
  ipId              String
  week              Week
  releasedCohortId  String
  claimedCohortId   String
  note              String?
  createdAt         DateTime @default(now())

  cycle          RotationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  ip             Ip            @relation(fields: [ipId], references: [id], onDelete: Cascade)
  releasedCohort Cohort        @relation("TradeReleased", fields: [releasedCohortId], references: [id])
  claimedCohort  Cohort        @relation("TradeClaimed", fields: [claimedCohortId], references: [id])
}

/// Per-cohort, per-IP, per-week status within a rotation cycle (PRD 6.6:
/// Pending / Partial / Done), independent from the brand x IP matrix.
model CohortWeeklyStatus {
  id       String      @id @default(cuid())
  cycleId  String
  cohortId String
  ipId     String
  week     Week
  status   StatusState @default(PENDING)

  cycle  RotationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  cohort Cohort        @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  ip     Ip            @relation(fields: [ipId], references: [id], onDelete: Cascade)

  @@unique([cycleId, cohortId, ipId, week])
}

/// One person's working day: clock-in and clock-out times (stored in UTC).
model AttendanceDay {
  id       String    @id @default(cuid())
  personId String
  /// The working day in India time, "YYYY-MM-DD".
  day      String
  clockIn  DateTime
  clockOut DateTime?
  note     String?

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, day])
  @@index([day])
}
