DATABASE_URL="postgresql://user:password@localhost:5432/warroom_dev?schema=public"

# Only needed for pooled providers (Neon, Supabase, PgBouncer): an unpooled
# connection string the migration engine uses. Leave unset for a plain
# Postgres instance (e.g. local dev) where DATABASE_URL already isn't pooled.
DIRECT_URL="postgresql://user:password@localhost:5432/warroom_dev?schema=public"

# Needed for "Upload a calendar screenshot" on the Log it page (reads a
# calendar photo and drafts the planned posts). Get a key from
# https://console.anthropic.com -> Settings -> API Keys. Without this set,
# the rest of the app works fine - only that one button is disabled.
ANTHROPIC_API_KEY=""
